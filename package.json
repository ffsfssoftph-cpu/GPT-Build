{
  "name": "caresuite-platform",
  "private": true,
  "version": "1.0.0",
  "author": "FS Softwares",
  "description": "Care Suite Ultima web service and cross-platform desktop shell",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node server/index.cjs",
    "dev": "node server/index.cjs",
    "desktop": "electron .",
    "dist": "electron-builder",
    "prepare-client": "node scripts/prepare-client.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.fssoftwares.caresuite",
    "productName": "Care Suite Ultima",
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "files": [
      "server/**/*",
      "desktop/**/*",
      "web/public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
